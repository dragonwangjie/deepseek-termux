#!/data/data/com.termux/files/usr/bin/sh
H=/data/data/com.termux/files/home
U=/data/data/com.termux/files/usr
L=$H/dsh_web.log
P=3080
export LD_LIBRARY_PATH=$U/lib
export PATH=$U/bin:/system/bin:/system/xbin
export HOME=$H
tok() { grep -o "http://[^ ]*token=[^ ]*" "$L" 2>/dev/null | tail -1; }
good() {
  u=$(tok)
  [ -n "$u" ] || return 1
  t=$(printf %s "$u" | sed "s/.*token=//")
  v=$($U/bin/curl -s -m 5 -o /dev/null -w "%{http_code}" "http://127.0.0.1:$P/?token=$t")
  [ "$v" = "303" ] || [ "$v" = "200" ]
}
out() { printf "%s\n" "$1" > "$H/dsh_url.txt.tmp"; mv "$H/dsh_url.txt.tmp" "$H/dsh_url.txt"; printf "%s\n" "$1"; }
if good; then
  pgrep -f supervise.sh >/dev/null 2>&1 || setsid "$U/bin/sh" "$H/supervise.sh" >> "$H/supervise.log" 2>&1 </dev/null &
  out "$(tok)"; exit 0
fi
echo "not responding, starting (20-40s)..."
pkill -9 -f "dsh/lib/bin.js" 2>/dev/null
sleep 1
: > "$L"
setsid "$U/bin/sh" "$H/run-dsh.sh" >> "$L" 2>&1 </dev/null &
n=0
while [ $n -lt 12 ]; do
  sleep 3; n=$((n+1))
  good && break
done
if good; then
  out "$(tok)"
  pgrep -f supervise.sh >/dev/null 2>&1 || setsid "$U/bin/sh" "$H/supervise.sh" >> "$H/supervise.log" 2>&1 </dev/null &
else
  echo "FAILED: tail -20 $L"; exit 1
fi
